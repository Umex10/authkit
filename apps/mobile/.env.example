# Base URL of the AuthKit backend (Spring Boot).
# The app appends the API prefix itself, e.g. ${EXPO_PUBLIC_BACKEND_URL}/api/v1/auth/sign-in
#
# Defaults to http://localhost:8080 in code, so you only need this file if your
# backend runs elsewhere. Copy it to .env and adjust.
#
# IMPORTANT — "localhost" means the phone/emulator itself, not your computer:
#   • iOS simulator ........ http://localhost:8080 works as-is
#   • Android emulator ..... http://10.0.2.2:8080   (the emulator's alias for the host)
#   • Physical device ...... http://<your-computer-LAN-IP>:8080  (e.g. http://192.168.1.20:8080)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080
